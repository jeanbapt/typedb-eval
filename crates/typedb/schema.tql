define

attribute entity-id, value string;
attribute person-name, value string;
attribute canonical-name, value string;
attribute company-name, value string;
attribute jurisdiction-code, value string;
attribute share-pct, value double;
attribute evidence-state, value string;
attribute governance-level, value string;
attribute context-type, value string;
attribute role-type, value string;
attribute source-id, value string;
attribute source-authority, value double;
attribute predicate-name, value string;
attribute list-name, value string;
attribute listed-flag, value boolean;
attribute rule-id, value string;
attribute threshold-pct, value double;
attribute valid-from, value datetime;
attribute valid-to, value datetime;
attribute known-from, value datetime;
attribute known-to, value datetime;
attribute observed-at, value datetime;
attribute alias-text, value string;
attribute merge-flag, value boolean;

attribute assertion-id, value string;

attribute trust-name, value string;

entity person,
    owns entity-id @key,
    owns person-name,
    owns canonical-name,
    owns jurisdiction-code,
    plays ownership:owner,
    plays identity-link:linked-person,
    plays sanction-listing:sanctioned-person,
    plays generic-assertion:subject,
    plays generic-assertion:object,
    plays control-via-nominee:controller,
    plays control-via-nominee:nominee;

entity company,
    owns entity-id @key,
    owns company-name,
    owns jurisdiction-code,
    plays ownership:owner,
    plays ownership:owned,
    plays generic-assertion:subject,
    plays generic-assertion:object,
    plays control-via-nominee:controller,
    plays control-via-nominee:controlled;

# Ontology extension: a third party kind. Declaring it able to fill an existing role is a
# one-line schema statement; no table, no discriminator column, no foreign-key exception.
entity trust,
    owns entity-id @key,
    owns trust-name,
    owns jurisdiction-code,
    plays control-via-nominee:controller,
    plays control-via-nominee:instrument;

relation ownership,
    relates owner,
    relates owned,
    owns share-pct,
    owns evidence-state,
    owns governance-level,
    owns context-type,
    owns role-type,
    owns jurisdiction-code,
    owns source-id,
    owns source-authority,
    owns valid-from,
    owns valid-to,
    owns known-from,
    owns known-to,
    owns observed-at,
    owns assertion-id;

relation identity-link,
    relates linked-person,
    owns alias-text,
    owns canonical-name,
    owns merge-flag,
    owns context-type,
    owns observed-at;

relation sanction-listing,
    relates sanctioned-person,
    owns list-name,
    owns listed-flag,
    owns context-type,
    owns valid-from,
    owns valid-to,
    owns known-from,
    owns known-to;

relation generic-assertion,
    relates subject,
    relates object,
    owns predicate-name,
    owns evidence-state,
    owns governance-level,
    owns context-type,
    owns jurisdiction-code,
    owns source-id,
    owns source-authority,
    owns valid-from,
    owns valid-to,
    owns known-from,
    owns known-to,
    owns observed-at,
    owns assertion-id;

# Ontology extension: genuinely 4-ary, with a polymorphic `controller` role fillable by
# person, company or trust.
relation control-via-nominee,
    relates controller,
    relates controlled,
    relates nominee,
    relates instrument,
    owns context-type,
    owns jurisdiction-code,
    owns source-id,
    owns source-authority,
    owns valid-from,
    owns valid-to,
    owns known-from,
    owns known-to,
    owns observed-at;

entity compliance-rule,
    owns rule-id @key,
    owns threshold-pct;

# Bitemporal edge visibility, shared by the recursive functions below. An edge is
# active at (valid, known) when both intervals started at or before the probe
# instants and no upper bound at or before them exists (absent attribute = open
# interval), and its evidence is not REFUTED.
#
# TypeDB 3.12 rejects `not { ... }` in the body of a *recursive* function
# (stratification guard, applied syntactically per function), so the negations
# live in these non-recursive helpers and the recursive function only composes
# function calls.
fun active-company-owners($owned: company, $valid: datetime, $known: datetime) -> { company }:
    match
        $o isa ownership, links (owner: $c, owned: $owned);
        $c isa company;
        $o has valid-from $vf, has known-from $kf, has evidence-state $ev;
        $vf <= $valid;
        $kf <= $known;
        not { $ev == "REFUTED"; };
        not { $o has valid-to $vt; $vt <= $valid; };
        not { $o has known-to $kt; $kt <= $known; };
    return { $c };

fun active-person-owners($owned: company, $valid: datetime, $known: datetime) -> { person }:
    match
        $o isa ownership, links (owner: $p, owned: $owned);
        $p isa person;
        $o has valid-from $vf, has known-from $kf, has evidence-state $ev;
        $vf <= $valid;
        $kf <= $known;
        not { $ev == "REFUTED"; };
        not { $o has valid-to $vt; $vt <= $valid; };
        not { $o has known-to $kt; $kt <= $known; };
    return { $p };

# Companies transitively owning $target through active edges. Left-recursive per
# the TypeQL optimization guide: the recursive call always receives the original
# arguments, so tabled execution builds a single table per (target, valid, known)
# instead of one per intermediate company.
fun transitive-owner-companies($target: company, $valid: datetime, $known: datetime) -> { company }:
    match
        {
            let $c in active-company-owners($target, $valid, $known);
        } or {
            let $via in transitive-owner-companies($target, $valid, $known);
            let $c in active-company-owners($via, $valid, $known);
        };
    return { $c };

# Downward counterparts: companies one active edge below an owner, and the
# transitive closure from a fixed root. Exposure (Q5/Q7/Q8) walks down from the
# probe entity, so the left-recursive form keys its single table on the root
# instead of scanning every company.
fun active-owned-companies($owner: company, $valid: datetime, $known: datetime) -> { company }:
    match
        $o isa ownership, links (owner: $owner, owned: $c);
        $c isa company;
        $o has valid-from $vf, has known-from $kf, has evidence-state $ev;
        $vf <= $valid;
        $kf <= $known;
        not { $ev == "REFUTED"; };
        not { $o has valid-to $vt; $vt <= $valid; };
        not { $o has known-to $kt; $kt <= $known; };
    return { $c };

fun active-owned-companies-of-person($owner: person, $valid: datetime, $known: datetime) -> { company }:
    match
        $o isa ownership, links (owner: $owner, owned: $c);
        $c isa company;
        $o has valid-from $vf, has known-from $kf, has evidence-state $ev;
        $vf <= $valid;
        $kf <= $known;
        not { $ev == "REFUTED"; };
        not { $o has valid-to $vt; $vt <= $valid; };
        not { $o has known-to $kt; $kt <= $known; };
    return { $c };

fun transitive-owned-companies($root: company, $valid: datetime, $known: datetime) -> { company }:
    match
        {
            let $c in active-owned-companies($root, $valid, $known);
        } or {
            let $via in transitive-owned-companies($root, $valid, $known);
            let $c in active-owned-companies($via, $valid, $known);
        };
    return { $c };

# Persons one active edge above $target or above any company transitively owning
# it. Not itself recursive; the recursion (and its single table) lives in
# transitive-owner-companies.
fun transitive-owner-persons($target: company, $valid: datetime, $known: datetime) -> { person }:
    match
        {
            let $p in active-person-owners($target, $valid, $known);
        } or {
            let $mid in transitive-owner-companies($target, $valid, $known);
            let $p in active-person-owners($mid, $valid, $known);
        };
    return { $p };
